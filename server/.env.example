# Copy to .env and edit. Never commit the real .env.
NODE_ENV=development
PORT=3000

# Local MongoDB:      mongodb://127.0.0.1:27017/teammotor
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/teammotor?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/teammotor

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Only needed if the frontend is served from a different origin than the API (comma-separated).
# Leave empty when Express serves ../public itself (the default setup).
CORS_ORIGINS=

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email (Gmail SMTP) for Forgot Password OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Seed passwords (used only by `npm run seed`). Change them after first login.
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_PASSWORD=Staff@12345
